pipeline {
    agent { label 'AGENT-1' }
    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        ansiColor('xterm')
    }
    parameters{
        choice(name: 'ACTION', choices:['Apply', 'Destroy'],, description: 'Pick something')
    } 
    stages {
        stage('Init') {
            steps {
               script{
                withAWS(region: 'us-east-1', credentials: 'aws-creds') {
                    sh """
                        cd 01-vpc
                        terraform init -reconfigure
                        terraform plan
                        ls 
                        pwd
                        cd 02-sg
                        terraform init -reconfigure
                        terraform plan

                        cd 04-db
                        terraform init -reconfigure
                        terraform plan

                         cd 05-vpn
                        terraform init -reconfigure
                        terraform plan
                        terraform apply -auto-approve
                    
                        cd 06-app-alb
                        terraform init -reconfigure
                        terraform plan

                        cd 08-acm
                        terraform init -reconfigure
                        terraform plan

                        cd 09-web-alb
                        terraform init -reconfigure
                        terraform plan

                        cd 11-cdn
                        terraform init -reconfigure
                        terraform plan
                    """
                }
                 
               }
            }
        }
        stage('Apply') {
          when {
                expression{
                        params.action == 'Apply'
                    }
                }
          input {
                message "Should we continue?"
                ok "Yes, we should."
            } 
            steps {
               script{
                withAWS(region: 'us-east-1', credentials: 'aws-creds') {
                    sh """
                        cd 01-vpc
                        terraform apply -auto-approve

                        cd 02-sg 
                        terraform apply -auto-appvoe
                        
                        cd 04-db
                        terraform apply -auto-approve

                        cd 06-app-alb
                        terraform apply -auto-approve

                        cd 08-acm
                        terraform apply -auto-approve

                        cd 09-web-alb
                        terraform apply -auto-approve

                        cd 11-cdn
                        terraform apply -auto-approve
                    """
                }
                 
               }
            }
        }
        stage('Destroy') {
            when {
                expression{
                    params.action == 'Destroy'
                }
            }
            steps {
                sh """
                cd 11-cdn
                terraform destroy -auto-approve
                
                cd 09-web-alb
                terraform destroy -auto-approve

                cd 08-acm
                terraform destroy -auto-approve

                cd 06-app-alb
                terraform destroy -auto-approve

                cd 05-vpn
                terraform destroy -auto-approve

                cd 04-db
                terraform destroy -auto-approve

                cd 02-sg
                terraform destroy -auto-approve

                cd 01-vpc
                terraform destroy -auto-approve
                """
            }
        }
    }
    post { 
        always { 
            echo 'I will always say Hello again!'
            deleteDir()
        }
        failure { 
            echo 'I will run when pipeline is failed'
        }
        success { 
            echo 'I will run when pipeline is success'
        }
    }
}